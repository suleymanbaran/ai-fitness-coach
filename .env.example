# true = run offline without OpenAI (fake embeddings, prompt shown instead of an AI answer)
DEMO_MODE=false
OPENAI_API_KEY=sk-your-key-here
# Two-tier router: fast model for chat/logging/extraction, plan model for program generation.
FAST_MODEL=gpt-6-luna
PLAN_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-small
# Explicit 12h cache breakpoint on the stable prefix + implicit 30m session caching.
ENABLE_PROMPT_CACHING=true
CACHE_TTL_STABLE=12h
CACHE_TTL_SESSION=30m
CHAT_HISTORY_TURNS=8
MEMORY_MAX_ENTRIES=40
TOOL_MAX_ITERATIONS=6
# Built-in OpenAI web search ($10/1k calls): calorie fallback when FatSecret's US-only free
# database has no match (e.g. Turkish/Italian dishes).
ENABLE_WEB_SEARCH=false
PHOTO_RATE_LIMIT_PER_MINUTE=5

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitness_coach

# The Qdrant server from docker-compose. Remove this line to use embedded Qdrant at QDRANT_PATH instead.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=protocols
RAG_TOP_K=3

# Connected apps (optional). See README, "Connect your data".
# Generate with: python -m scripts.generate_key
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Google's OAuth form rejects http://. scripts/local_https.py serves this address.
PUBLIC_API_URL=https://localhost:8443
UI_URL=http://localhost:8501

# FatSecret Basic (free) is the default. Set true only for a Premier/Premier-Free key
# (unlocks foods.search v6). Basic = US food database, 5,000 calls/day.
FATSECRET_PREMIER=false

# Telegram bot (python -m scripts.telegram_bot). Long-polling: no public URL needed.
# TELEGRAM_BOT_TOKEN: from @BotFather. TELEGRAM_ALLOWED_CHAT_ID: your chat id (e.g. @userinfobot);
# the bot refuses to start or serve without it. TELEGRAM_API_TOKEN: python -m scripts.issue_token <user>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_TOKEN=
TELEGRAM_API_URL=http://localhost:8000
TELEGRAM_BOUND_USER_ID=me
TELEGRAM_ALLOWED_CHAT_ID=
