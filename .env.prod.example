# Copy to .env.prod on the server. Never commit .env.prod.
DOMAIN=coach.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=sk-your-key-here
FAST_MODEL=gpt-6-luna
PLAN_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_PROMPT_CACHING=true
CACHE_TTL_STABLE=12h
CACHE_TTL_SESSION=30m
CHAT_HISTORY_TURNS=8
MEMORY_MAX_ENTRIES=40
TOOL_MAX_ITERATIONS=6
RAG_TOP_K=3
ASK_RATE_LIMIT_PER_MINUTE=20
PHOTO_RATE_LIMIT_PER_MINUTE=5
OPENAI_TIMEOUT_SECONDS=30
ENABLE_WEB_SEARCH=false

# Connected apps (optional). Register https://<DOMAIN>/integrations/google/callback with Google.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Basic (free) key: leave false. Premier / Premier-Free key: true (enables foods.search v6).
FATSECRET_PREMIER=false

# Telegram bot service (optional). TELEGRAM_API_TOKEN: python -m scripts.issue_token me
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_TOKEN=
TELEGRAM_BOUND_USER_ID=me
TELEGRAM_ALLOWED_CHAT_ID=
